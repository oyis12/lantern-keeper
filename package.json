{
  "name": "lantern-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A breathing-responsive coastal village powered by Presage SmartSpectra",
  "main": "electron/main.cjs",
  "scripts": {
    "setup:desktop": "install-electron",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "check": "npm run test && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "directories": { "output": "release" },
    "appId": "com.lanternkeeper.desktop",
    "productName": "The Lantern Keeper",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/@smartspectra/node-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra/"
        }
      ]
    }
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
